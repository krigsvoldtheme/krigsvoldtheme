{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krigsvoldtheme",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/mcp",
      "/health",
      "/",
      "/design-language/*",
      "/design-system/*",
      "/design-system.json",
      "/agents/*",
      "/privacy-and-cookie-notice/*",
      "/react",
      "/react/*"
    ]
  }
}
