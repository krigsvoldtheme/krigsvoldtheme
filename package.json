{
  "name": "krigsvold-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Krigsvold Light and Dark themes in paper, navy, glacier blue, and bronze",
  "scripts": {
    "tokens": "node scripts/generate.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run tokens && astro dev --root site",
    "build": "npm run tokens && astro build --root site",
    "preview": "astro preview --root site",
    "test:browser": "node scripts/check-consent.mjs"
  },
  "devDependencies": {
    "astro": "^5.14.0",
    "bplist-creator": "^0.3.0",
    "bplist-parser": "^0.5.0",
    "playwright": "^1.64.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@krigsvold/theme": "2.0.0",
    "@krigsvold/astro": "1.0.0"
  }
}
