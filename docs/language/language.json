{
  "schemaVersion": 1,
  "family": "krigsvold",
  "grammarVersion": "0.3",
  "maturity": "experimental",
  "source": {
    "repository": "basuhoward/krigsvold.org",
    "commit": "a3cf072c516c59ed35814e0fa153028cc91ceecd"
  },
  "guidance": {
    "grammar": "docs/grammar.md",
    "decisions": "docs/source-decisions.md",
    "foundations": "docs/foundations.md",
    "coverage": "docs/coverage.md",
    "validatedForm": "docs/patterns/forms.md",
    "queryResults": "docs/patterns/query-results.md",
    "nativeHtml": "docs/native-html.md",
    "formStyling": "docs/form-styling.md"
  },
  "implementation": {
    "core": {
      "version": "2.2.3",
      "status": "experimental",
      "sourceProfile": "opt-in; existing defaults retained"
    },
    "Astro": {
      "version": "1.2.2",
      "status": "experimental",
      "core": "^2.2.3",
      "additions": [
        "TableOfContents",
        "ArticleLayout contents slot",
        "SiteFooter grouped variant"
      ]
    },
    "React": {
      "version": "0.1.0",
      "status": "experimental",
      "core": "2.1.0",
      "repository": "howardjp/design-workbench",
      "branch": "work/registry-foundations",
      "release": "https://github.com/howardjp/design-workbench/releases/tag/react-v0.1.0"
    },
    "Vue": {
      "status": "not-implemented"
    },
    "Svelte": {
      "status": "not-implemented"
    },
    "native": {
      "status": "not-implemented"
    }
  },
  "patterns": [
    {
      "id": "reading-contents",
      "basis": "application-extension",
      "variants": [
        "index",
        "inline"
      ],
      "rules": [
        "Contents precedes body",
        "Depth 2 parents and depth 3 children",
        "Supporting information remains separate",
        "Reflow according to available container width"
      ]
    },
    {
      "id": "grouped-footer",
      "basis": "source-translation",
      "rules": [
        "Host supplies identity and destinations",
        "Preserve independent family anatomy",
        "Ownership and contact belong in base slot"
      ]
    },
    {
      "id": "collection-editor",
      "basis": "application-extension",
      "availability": "React specimen only",
      "states": [
        "empty",
        "no-match",
        "reading",
        "editing",
        "saving",
        "saved",
        "failed-save",
        "unsaved-navigation",
        "undo"
      ]
    },
    {
      "id": "validated-form",
      "basis": "application-extension",
      "availability": "React interactive reference; Astro native-HTML guidance",
      "states": [
        "invalid",
        "pending",
        "failed-save",
        "retry",
        "saved",
        "changed-reset",
        "keep",
        "discard"
      ],
      "rules": [
        "Field/group/region relationships",
        "Retain values on failure",
        "Summary links focus controls",
        "Guard specimen reset; host navigation remains host-owned"
      ]
    },
    {
      "id": "query-results",
      "basis": "application-extension",
      "availability": "React interactive reference; Astro native-HTML guidance",
      "states": [
        "draft-query",
        "pending",
        "failed-load",
        "retry",
        "no-match",
        "empty-source",
        "selected",
        "preparing",
        "failed-prepare",
        "prepared",
        "cancelled"
      ],
      "rules": [
        "Separate draft and committed scope",
        "Stable record identities",
        "Current-page selection only",
        "Cancel invalidates late completion",
        "Keep all table columns in labelled scrolling region"
      ]
    }
  ],
  "openGates": [
    "Manual assistive-technology review",
    "Localization and RTL",
    "Sustained consumer use",
    "Broader form and data workflow evidence",
    "Matched origin code specimen"
  ],
  "coverage": [
    {
      "id": "G01",
      "domain": "Source authority",
      "status": "Documented",
      "rule": "Origin objects, translations and extensions remain distinct."
    },
    {
      "id": "G02",
      "domain": "Field / group / region spacing",
      "status": "Rule clarified + reference",
      "rule": "Use relational roles; do not inherit page-section spacing inside forms."
    },
    {
      "id": "G03",
      "domain": "Density and targets",
      "status": "Claim corrected; compact open",
      "rule": "Comfortable examples only; 44px is a design target, not blanket certification."
    },
    {
      "id": "G04",
      "domain": "Typography and hierarchy",
      "status": "Observed roles retained",
      "rule": "Keep prose, UI, selective display and code roles; no decorative monospace."
    },
    {
      "id": "G05",
      "domain": "Surfaces and layers",
      "status": "Rule corrected + reference",
      "rule": "Modal, popup and inline disclosure have different interaction contracts."
    },
    {
      "id": "G06",
      "domain": "Action placement and scope",
      "status": "Rule clarified + reference",
      "rule": "Commands name and follow their field, object or collection scope."
    },
    {
      "id": "G07",
      "domain": "Responsive composition",
      "status": "Reference checks",
      "rule": "Reflow fields/actions; scroll only genuine comparison surfaces; retain source order."
    },
    {
      "id": "G08",
      "domain": "Substantial forms",
      "status": "New experimental contract",
      "rule": "Validate, retain values, retry and guard specimen reset."
    },
    {
      "id": "G09",
      "domain": "Query / sort / page",
      "status": "New experimental contract",
      "rule": "Draft query differs from applied results; changed query starts page 1."
    },
    {
      "id": "G10",
      "domain": "Selection",
      "status": "New bounded contract",
      "rule": "Binary current-page selection; scope changes reset on commit, failure retains it."
    },
    {
      "id": "G11",
      "domain": "Pending / failed / empty states",
      "status": "Reference coverage expanded",
      "rule": "Keep useful previous content and distinguish no matches from empty source data."
    },
    {
      "id": "G12",
      "domain": "Focus and recovery",
      "status": "Reference checks; manual open",
      "rule": "Summary links, modal dismissal, return trigger and late-response cancellation."
    },
    {
      "id": "G13",
      "domain": "Top / side / focused frames",
      "status": "Existing support retained",
      "rule": "Frame follows task; source navigation direction is not a family restriction."
    },
    {
      "id": "G14",
      "domain": "Reading / contents / footer",
      "status": "Existing source contracts retained",
      "rule": "Contents, body, support and host identity remain separate."
    },
    {
      "id": "G15",
      "domain": "Cross-framework agreement",
      "status": "Availability clarified",
      "rule": "Rules cross frameworks; React state/focus props do not become Astro APIs."
    },
    {
      "id": "G16",
      "domain": "Figure / footnote / maths / archive vocabulary",
      "status": "Open",
      "rule": "Do not infer shipped components from origin CSS."
    },
    {
      "id": "G17",
      "domain": "Localization / RTL / assistive technology",
      "status": "Open",
      "rule": "Long-text checks are partial evidence; no manual or locale certification."
    },
    {
      "id": "G18",
      "domain": "Sustained use / dashboard breadth",
      "status": "Open",
      "rule": "Focused references do not establish production fitness or cover all application patterns."
    }
  ],
  "availability": "Implementation status describes maturity. Check the registry and the separately verified distribution record for publication availability."
}
