---
import { themes,heritage } from '../../../src/palettes.mjs';
import { contrastRatio } from '../../../src/contrast.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { version } from '../../../package.json';
import ThemeSpecimen from '../components/ThemeSpecimen.astro';
import AppDownloads from '../components/AppDownloads.astro';
import FoundationSpecimen from '../components/FoundationSpecimen.astro';
const entries=Object.values(themes);
const origins=[['Navy 950',heritage.navy950],['Navy 900',heritage.navy900],['Navy 800',heritage.navy800],['Blue',heritage.blue600],['Ice 400',heritage.ice400],['Ice 200',heritage.ice200],['Ice 100',heritage.ice100],['Paper',heritage.paper],['Ink',heritage.ink],['Muted',heritage.muted],['Rule',heritage.rule],['Bronze',heritage.gold]];
const pairs=Object.entries(themes.light.tokens);
const colors=pairs.filter(([,value])=>/^#[a-f\d]{6}$/i.test(value));
const category=(key)=>key.startsWith('syntax-')?'syntax':key.startsWith('chart-')?'charts':/^(info|success|warning|danger|error|green)/.test(key)?'status':'interface';
const downloads=[['CSS variables','Scoped Light and Dark themes','krigsvold.css'],['JSON tokens','The complete color specification','krigsvold.json'],['Light CSS','Light theme on its own','krigsvold-light.css'],['Dark CSS','Dark theme on its own','krigsvold-dark.css'],['VS Code Light','Starter color definition','krigsvold-light-vscode.json'],['VS Code Dark','Starter color definition','krigsvold-dark-vscode.json'],['Terminal Light JSON','Sixteen ANSI colors','krigsvold-light-terminal.json'],['Terminal Dark JSON','Sixteen ANSI colors','krigsvold-dark-terminal.json']];
---
<BaseLayout>
  <header class="landscape-cover">
    <div class="cover-copy"><h1>Krigsvold</h1><p class="cover-line">Paper, sea, and ice.</p><p class="cover-description">Two ways to settle into your work.<br />Warm paper by day. Deep navy after dark.</p><a class="cover-link" href="#preview">Find your light <span aria-hidden="true">↘</span></a></div>
    <svg class="palette-landscape" viewBox="0 0 800 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path fill="#0A1D35" d="M0 0h800v520H0z"/>
      <circle cx="612" cy="117" r="44" fill="#B58A3B"/>
      <path d="M0 130h800M0 260h800M0 390h800M200 0v520M400 0v520M600 0v520" stroke="#D9EEF4" stroke-opacity=".1" fill="none"/>
      <path fill="#123456" d="M0 300 195 173 353 260 555 142 800 257v263H0z"/>
      <path fill="#286A9D" d="m0 390 180-91 119 25 165-168 143 170 193 9v185H0z"/>
      <path fill="#D9EEF4" d="m144 520 320-364 98 175 117 189z"/>
      <path fill="#9ED5E6" d="m144 520 320-364-63 262 118 102z"/>
      <path fill="#EEF8FA" d="m464 156 98 175-161 87z"/>
      <path fill="#061325" d="M0 468 184 419 332 483 578 407 800 458v62H0z"/>
      <path d="m0 489 184-49 148 64 246-76 222 51" stroke="#9ED5E6" stroke-opacity=".4" fill="none"/>
    </svg>
    <div class="cover-meta"><span>Light + Dark</span><span>88 color roles per theme</span><span>Open source · v{version}</span></div>
  </header>
  <div class="source-ribbon" aria-label="The twelve source colors; select a color to copy it">{origins.map(([name,hex])=><button type="button" data-copy={hex} style={`--source-color:${hex}`} aria-label={`Copy original ${name.toLowerCase()} ${hex}`} title={`${name} · ${hex}`}><span class="sr-only">{name}: {hex}</span></button>)}</div>

  <div id="workbench" class="workbench" data-krigsvold="light">
    <div class="workbench-toolbar">
      <nav class="workspace-nav" aria-label="Theme workbench"><a href="#preview" data-workspace-link="preview">Preview</a><a href="#palette" data-workspace-link="palette">Color lab</a><a href="#downloads" data-workspace-link="downloads">Downloads</a></nav>
      <div class="appearance-control" role="group" aria-label="Workbench appearance"><button type="button" data-mode="light" aria-pressed="true"><span aria-hidden="true">☀</span> Light</button><button type="button" data-mode="dark" aria-pressed="false"><span aria-hidden="true">◒</span> Dark</button></div>
    </div>
    <section id="preview" class="preview-workspace" data-workspace-panel aria-labelledby="preview-title" tabindex="-1">
      <header class="workspace-heading"><div><h2 id="preview-title">A view of your next workspace.</h2><p>Same colors. Different places to use them.</p></div><div class="view-switch" role="group" aria-label="Example type"><button type="button" data-example="interface" aria-pressed="true">Interface</button><button type="button" data-example="code" aria-pressed="false">Code</button><button type="button" data-example="terminal" aria-pressed="false">Terminal</button></div></header>
      <div class="specimen-spread">{entries.map(theme=><ThemeSpecimen theme={theme}/>)}</div>
      <p class="caption">These are working color specimens. Click a swatch to copy its value, or open the Color lab to inspect all 88 roles.</p>
      <FoundationSpecimen />
    </section>

    <section id="palette" class="palette-workspace" data-workspace-panel aria-labelledby="palette-title" tabindex="-1">
      <header class="workspace-heading"><div><h2 id="palette-title">Find the right relationship.</h2><p>Pair two colors, check their contrast, or look up a named role.</p></div><p class="lab-mode" data-mode-label>Light · 88 roles</p></header>
      <div class="workspace-columns">
        <div id="tokens" class="token-reference">
          <div class="token-filters"><label>Find a token<input id="token-search" type="search" placeholder="Try accent, syntax, or border" autocomplete="off" /></label><label>Show<select id="token-category"><option value="all">All roles</option><option value="interface">Interface</option><option value="status">Status</option><option value="syntax">Syntax</option><option value="charts">Charts</option></select></label></div>
          <p id="token-count" class="reference-count" role="status">{pairs.length} tokens · Light palette</p>
          <div class="token-scroll" role="region" aria-label="Color token reference" tabindex="0">
            <table class="token-table"><thead><tr><th scope="col">Token</th><th scope="col">Value</th><th scope="col"><span class="sr-only">Copy value</span></th></tr></thead><tbody>{pairs.map(([key,value])=><tr data-token={key} data-category={category(key)} data-light={value} data-dark={themes.dark.tokens[key]}><th scope="row"><span class="token-color" style={key==='shadow'?`box-shadow:${value}`:`background:${value}`}></span><code>{key}</code></th><td class="token-value"><code>{value}</code></td><td><button class="copy-token" type="button" data-copy={value} aria-label={`Copy ${key} ${value}`}>Copy</button></td></tr>)}</tbody></table>
          </div>
          <p id="no-tokens" class="empty-result" hidden>No matching tokens. Try another name or category.</p>
          <p class="caption">CSS names use the prefix <code>--krigsvold-</code>. Shadow and translucent colors are included in the reference.</p>
        </div>
        <aside class="contrast-inspector" aria-labelledby="contrast-title">
          <h3 id="contrast-title">Put two colors together.</h3><p>Check a foreground against a background before you use it.</p>
          <div class="contrast-controls"><label>Foreground<select id="contrast-foreground">{colors.map(([key])=><option value={key} selected={key==='text'}>{key}</option>)}</select></label><label>Background<select id="contrast-background">{colors.map(([key])=><option value={key} selected={key==='bg'}>{key}</option>)}</select></label></div>
          <div id="contrast-sample" class="contrast-sample" style={`background:${themes.light.tokens.bg};color:${themes.light.tokens.text}`}><span>Aa</span><p>A little room to think.<br />A clear place to begin.</p></div>
          <div class="contrast-result" aria-live="polite" aria-atomic="true"><strong id="contrast-ratio">{contrastRatio(themes.light.tokens.text,themes.light.tokens.bg).toFixed(2)}:1</strong><span id="contrast-verdict">AA and AAA for normal text</span></div>
          <p class="caption">WCAG 2 contrast for the selected opaque sRGB colors. A passing pair does not establish accessibility for a whole application.</p>
        </aside>
      </div>
    </section>

    <section id="downloads" class="get-krigsvold" data-workspace-panel aria-labelledby="download-title" tabindex="-1">
      <header class="workspace-heading"><div><h2 id="download-title">Take Krigsvold with you.</h2><p>Use the palette in a website, an editor, or Terminal.app.</p></div><a class="source-link" href="https://github.com/krigsvoldtheme/krigsvoldtheme">Browse the source ↗</a></header>
      <div class="installation-grid">
        <article class="terminal-download"><div class="terminal-symbol" aria-hidden="true">&gt;_</div><h3>Terminal.app</h3><p>Native profiles for the terminal included with macOS. Background, text, cursor, selection, and all sixteen ANSI colors.</p><div class="terminal-download-links"><a href="/downloads/krigsvold-light.terminal" download>Krigsvold Light <span>↓ .terminal</span></a><a href="/downloads/krigsvold-dark.terminal" download>Krigsvold Dark <span>↓ .terminal</span></a></div><details><summary>How to install</summary><ol><li>Download either profile.</li><li>Open Terminal and choose <strong>Terminal → Settings → Profiles</strong>.</li><li>Use the action menu beneath the profiles list to choose <strong>Import</strong>, then select the downloaded file. You can also drag the file into that list.</li><li>Select Krigsvold Light or Krigsvold Dark. Choose <strong>Default</strong> if you want it for new windows.</li></ol><p><a href="https://support.apple.com/guide/terminal/import-and-export-terminal-profiles-trml4299c696/mac">Apple’s profile import guide ↗</a></p><p>These profiles have not yet been tested in Terminal.app on a Mac.</p></details></article>
        <div class="download-list">{downloads.map(([title,description,file])=><a href={`/downloads/${file}`} download><span><strong>{title}</strong><small>{description}</small></span><code>{file.endsWith('.css')?'.css':'.json'} ↓</code></a>)}</div>
      </div>
      <article class="zsh-download" aria-labelledby="zsh-title"><div><h3 id="zsh-title">A prompt to match.</h3><p>A compact single-line prompt in glacier blue or cool blue, with bronze accents and Git state. Both variants show command failures and work with plain Zsh or Oh My Zsh. No special font required.</p><pre aria-label="Illustrative Krigsvold Zsh prompt"><code>~/projects [krigsvold +1 ~2 ?1] &gt; </code></pre></div><div class="zsh-files"><a href="/downloads/krigsvold-light.zsh-theme" download>Krigsvold Light <code>↓ .zsh-theme</code></a><a href="/downloads/krigsvold-dark.zsh-theme" download>Krigsvold Dark <code>↓ .zsh-theme</code></a></div><details><summary>Install the Zsh prompt</summary><p>Download a variant that matches your terminal background. Move it into <code>~/.config/zsh/themes/</code>:</p><pre><code>mkdir -p ~/.config/zsh/themes
cp ~/Downloads/krigsvold-dark.zsh-theme ~/.config/zsh/themes/</code></pre><p>Add this line at the end of <code>~/.zshrc</code>, after any shell framework or prompt setup, then open a new shell:</p><pre><code>source "$HOME/.config/zsh/themes/krigsvold-dark.zsh-theme"</code></pre><p>For Light, replace <code>krigsvold-dark</code> with <code>krigsvold-light</code>. For Oh My Zsh, you can instead put the file in its custom themes directory and set <code>ZSH_THEME="krigsvold-dark"</code> before loading Oh My Zsh.</p><p>Git markers: <code>+N</code> staged, <code>~N</code> unstaged, <code>?N</code> untracked entries, <code>xN</code> conflicts. A failed command shows its exit code. Set <code>KRIGSVOLD_GIT=0</code> before sourcing to omit Git inspection. Use Zsh 5.9 or newer. Truecolor terminals use the exact role colors; other terminals use ANSI palette slots, supplied by the matching Terminal.app profile. The prompt sets no terminal background; use the matching Terminal.app profile for that.</p></details></article>
      <AppDownloads />
      <details class="css-instructions"><summary>Use Krigsvold on a website</summary><p>Load the CSS, then set <code>data-krigsvold</code> to <code>light</code> or <code>dark</code> on the element you want to theme.</p><pre><code>&lt;link rel="stylesheet" href="krigsvold.css"&gt;
&lt;main data-krigsvold="dark"&gt;
  &lt;article class="panel"&gt;Hello, Krigsvold.&lt;/article&gt;
&lt;/main&gt;

.panel &#123;
  background: var(--krigsvold-panel);
  color: var(--krigsvold-text);
&#125;</code></pre><p>Light and Dark can also live in separate parts of the same page, as they do here. The VS Code files are starter color definitions; they are not packaged extensions.</p></details>
    </section>

  </div>
  <details id="story" class="palette-notes"><summary><span>About these colors</span><span aria-hidden="true">+</span></summary><div class="palette-notes-body"><h2>Twelve starting points. One family.</h2><p>The owner-supplied Krigsvold stylesheet starts with three deep navies, clear blue, three ice shades, warm paper, ink, muted gray, a pale rule, and bronze. Those original values form the twelve-color ribbon above. Select any band to copy its value.</p><p>Light places ink on paper, with blue for links and controls. Dark brings glacier blue forward against the deepest navy. Bronze stays a supporting accent; darker relatives of pale source colors keep small text readable.</p><p>Roboto Slab and Roboto carry over from that stylesheet. The interface roles, syntax colors, and terminal profiles are generated together. The faceted ice crystal is original artwork for this theme.</p><a href="https://github.com/krigsvoldtheme/krigsvoldtheme">Read the specification on GitHub ↗</a></div></details>
  <p id="copy-status" class="copy-feedback" role="status" aria-live="polite"></p>
  <dialog id="copy-dialog" class="copy-dialog" aria-labelledby="copy-title"><h2 id="copy-title">Copy this value</h2><p>Clipboard access is unavailable. Select the value below and copy it.</p><label>Color value<input id="copy-value" readonly /></label><button type="button" data-copy-close>Close</button></dialog>
  <script src="../scripts/specimen.js"></script>
</BaseLayout>
