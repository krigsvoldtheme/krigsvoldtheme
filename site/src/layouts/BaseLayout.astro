---
import '../styles/shell.css';
import ThemeLayout from '@krigsvold/astro/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Appearance from '../components/Appearance.astro';


const { title = 'Krigsvold · Design language 0.3 preview', description = 'Krigsvold Light and Dark, an independent design language for publishing, services, and applications, with components, patterns and agent tools, in paper, navy, ice, and bronze.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<ThemeLayout title={title} description={description} mainId="main" mainTabindex={-1}>
<Fragment slot="head">
  <meta name="theme-color" content="#061325" />
  <script is:inline>try { document.documentElement.dataset.appearance = localStorage.getItem("design-appearance") === "dark" ? "dark" : "light"; } catch {}</script>
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/android-chrome-512x512.png', Astro.site)} />
  <meta property="og:image:alt" content="Krigsvold's faceted ice-crystal theme mark" />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />
</Fragment>
  <SiteHeader slot="header" />
  <slot /><Appearance />
  <SiteFooter slot="footer" />
  <CookieConsent slot="body-end" />
</ThemeLayout>
